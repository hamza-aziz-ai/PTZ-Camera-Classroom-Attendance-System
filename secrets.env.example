# Copy to secrets.env and fill in real values. secrets.env is gitignored.

# PostgreSQL (database controller + API)
POSTGRES_USER=
POSTGRES_PASSWORD=

# API key for /lecture_data and /manual_attendance_update
API_KEY=

# PTZ camera ONVIF/RTSP access
CAM_PORT=80
CAM_USERNAME=
CAM_PASSWORD=

# Camera IPs per classroom
CAM_IP_SUPERNOVA=
CAM_IP_2F_32=
CAM_IP_AB_1_319=

# Institute ERP attendance endpoints per classroom
ERP_ENDPOINT_SUPERNOVA=
ERP_ENDPOINT_2F_32=
ERP_ENDPOINT_AB_1_319=

# Host IP -> institute mapping used by set_configuration.sh
ABESIT_HOST_IP=
GLBITM_HOST_IP=
